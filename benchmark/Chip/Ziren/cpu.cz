// Skeleton translation of CpuChip compute/constraint into CZ.
// Captures row layout and per-row checks; transition/dispatch logic can be filled iteratively.

import input;
const usize WORD_SIZE = 4;

Struct CpuRow {
    shard: field,
    clk_16bit_limb: field,
    clk_8bit_limb: field,

    shard_to_send: field,
    clk_to_send: field,

    pc: field,
    next_pc: field,
    next_next_pc: field,

    instruction: Instruction,
    num_extra_cycles: field,
    is_rw_a: field,
    is_check_memory: field,
    is_halt: field,
    is_sequential: field,

    op_a_value: Word,
    hi_or_prev_a: Word,
    op_b_value: Word,
    op_c_value: Word,

    is_real: field,
    op_a_immutable: field,
}

Component CpuChip {
    Computation populate(self, ev: CpuEvent) -> field {
        self.shard = ev.shard;
        self.clk_16bit_limb = ev.clk & 0xffff;
        self.clk_8bit_limb = (ev.clk >> 16) & 0xff;

        // shard/clk routed to opcode-specific chips only when needed; left explicit here.
        self.shard_to_send = ev.is_check_memory ? ev.shard : 0;
        self.clk_to_send = ev.is_check_memory ? ev.clk : 0;

        self.pc = ev.pc;
        self.next_pc = ev.next_pc;
        self.next_next_pc = ev.next_next_pc;

        self.instruction = ev.instruction;
        self.num_extra_cycles = ev.num_extra_cycles;
        self.is_rw_a = ev.is_rw_a;
        self.is_check_memory = ev.is_check_memory;
        self.is_halt = ev.is_halt;
        self.is_sequential = ev.is_sequential;

        self.op_a_value = ev.op_a_value;
        self.hi_or_prev_a = ev.hi_or_prev_a;
        self.op_b_value = ev.op_b_value;
        self.op_c_value = ev.op_c_value;

        self.is_real = ev.is_real;
        self.op_a_immutable = ev.op_a_immutable;

        // Return shard to keep deterministic output.
        return ev.shard;
    }

    Constraint eval(ev: CpuEvent, cols: CpuRow) {
        // Basic pass-through checks.
        assert_eq(cols.shard, ev.shard);
        assert_eq(cols.pc, ev.pc);
        assert_eq(cols.next_pc, ev.next_pc);
        assert_eq(cols.next_next_pc, ev.next_next_pc);

        // Flags are boolean.
        assert_bool(cols.is_real);
        assert_bool(cols.is_rw_a);
        assert_bool(cols.is_check_memory);
        assert_bool(cols.is_halt);
        assert_bool(cols.is_sequential);
        assert_bool(cols.op_a_immutable);
        assert_bool(cols.instruction.imm_b);
        assert_bool(cols.instruction.imm_c);

        // op_a_0 flag implied: if op_a == 0 then (ev.instruction.op_a == 0) is 1.
        field op_a_0 = cols.instruction.op_a == 0;

        // Sequencing sanity: when sequential and real, next_next_pc = next_pc + 4.
        assert_zero(cols.is_real * cols.is_sequential * (cols.next_next_pc - cols.next_pc - 4));

        // shard/clk routing: if not checking memory, routed values must be zero.
        field is_check_mem = cols.is_check_memory;
        assert_zero(cols.is_real * (1 - is_check_mem) * cols.shard_to_send);
        assert_zero(cols.is_real * (1 - is_check_mem) * cols.clk_to_send);

        // Halt implies no next real row (transition constraint to be added when next-row is wired).
        // Placeholder: per-row soundness only.

        // Range checks for clk limbs are delegated to ByteChip in full model; omitted here.

        // Send instruction triple to downstream chips (approximate key: pc, opcode, op_a_0).
        lookup SendInstruction(0, ev.pc, ev.instruction.opcode, ev.op_a_value.bytes[0]);
    }

    // TODO: add transition-aware constraints once next-row access is modeled in CZ:
    // - is_real monotone -> padding
    // - shard/clk continuity
    // - pc/next_pc chaining and public next_pc exposure
    // - send_program/receive_instruction style lookups

    Query(populate, self, ev; eval, cols, ev)
}
