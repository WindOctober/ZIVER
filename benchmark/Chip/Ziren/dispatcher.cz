// Event dispatcher skeleton: fan out CpuEvent to CpuChip and optional sub-chips.
// Sub-chip semantics to be filled; selectors gate which sub-event is active.

import input;
import cpu;
import add_sub;

Struct EventBundle {
    cpu: CpuEvent,
    alu: AluEvent,
    branch: BranchEvent,
    jump: JumpEvent,
    mem: MemInstrEvent,
    syscall: SyscallEvent,

    alu_is_real: field,
    branch_is_real: field,
    jump_is_real: field,
    mem_is_real: field,
    syscall_is_real: field,
}

Component EventsDispatcher {
    Computation dispatch(self, bundle: EventBundle) -> field {
        // No computation side effects; return a deterministic field.
        return bundle.cpu.pc;
    }

    Constraint eval(bundle: EventBundle) {
        // Always check CPU chip.
        CpuChip::eval(bundle.cpu, CpuRow {});

        // Gate sub-events; placeholders for chip-specific evals.
        assert_bool(bundle.alu_is_real);
        assert_bool(bundle.branch_is_real);
        assert_bool(bundle.jump_is_real);
        assert_bool(bundle.mem_is_real);
        assert_bool(bundle.syscall_is_real);

        // Call sub-chips when present.
        if (bundle.alu_is_real == 1) {
            AddSubChip::eval(bundle.alu, AddSubCols {});
        }
        // if bundle.branch_is_real == 1 { BranchChip::eval(bundle.branch, ...) }
        // if bundle.jump_is_real == 1 { JumpChip::eval(bundle.jump, ...) }
        // if bundle.mem_is_real == 1 { MemInstrChip::eval(bundle.mem, ...) }
        // if bundle.syscall_is_real == 1 { SyscallChip::eval(bundle.syscall, ...) }
    }

    Query(dispatch, self, bundle; eval, bundle)
}
