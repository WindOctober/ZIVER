// crates/core/machine/src/operations/is_zero.rs
Struct IsZeroOperation {
  input inverse: field,
  output result: field,
}

Component IsZeroOperation {
  Computation populate(self, a: field) -> field {
    if a == 0 {
      self.inverse = 0;
      self.result = 1;
    } else {
      self.inverse = a.inverse();
      self.result = 0;
    }
    return self.result;
  }

  Constraint eval(self, a: field,cols:IsZeroOperation, is_real: field) {
    assert_bool(self.result);

    field one = 1;
    field is_zero = one - self.inverse * a;
    assert_eq(is_zero , self.result);

    assert_eq(self.result * a, 0);
  }
  Query(populate,self;eval,cols)
}
