// Kalos #6: BNEINC only constrains limb 0 of the new `a` value.

const usize WORD_SIZE = 4;

Struct BneincUpperLimbsK6 {
    input prev_a: [u32; WORD_SIZE],
    output a: [u32; WORD_SIZE],
}

Component BneincUpperLimbsK6 {
    Computation populate(self) {
        for i in 0..WORD_SIZE {
            assert_range(self.prev_a[i], u8);
        }

        self.a[0] = self.prev_a[0] + 1;
        self.a[1] = self.prev_a[1];
        self.a[2] = self.prev_a[2];
        self.a[3] = self.prev_a[3];
    }

    Constraint eval(cols: BneincUpperLimbsK6) {
        for i in 0..WORD_SIZE {
            assert_range(cols.prev_a[i], u8);
        }

        assert_eq(cols.a[0], cols.prev_a[0] + 1);

        // Bug: missing `a[1..4] == prev_a[1..4]`.
    }

    Query(populate, self; eval, cols)
}
