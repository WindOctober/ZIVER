// Richer A4: keep two local selectors and their lookup activation pattern.

Struct PaddingLookupA4Rich {
    input is_real: Selector,
    input is_memory: Selector,
    input is_branch: Selector,
    input clk: field,
    input pc: field,
    output active_selector: field,
    output fired_lookup: field,
}

Component PaddingLookupA4Rich {
    Computation populate(self) {
        assert_bool(self.is_real);
        assert_bool(self.is_memory);
        assert_bool(self.is_branch);
        assert_zero(self.is_memory * self.is_branch);

        self.active_selector = self.is_memory + self.is_branch;
        assert_bool(self.active_selector);
        self.fired_lookup = self.is_real * self.active_selector;

        if (self.fired_lookup == 1) {
            lookup(SendInstruction, 0, self.clk, self.pc, self.active_selector);
        }
    }

    Constraint eval(cols: PaddingLookupA4Rich) {
        assert_bool(cols.is_real);
        assert_bool(cols.is_memory);
        assert_bool(cols.is_branch);
        assert_zero(cols.is_memory * cols.is_branch);

        assert_eq(cols.active_selector, cols.is_memory + cols.is_branch);
        assert_bool(cols.active_selector);
        assert_eq(cols.fired_lookup, cols.active_selector);

        if (cols.fired_lookup == 1) {
            lookup(SendInstruction, 0, cols.clk, cols.pc, cols.active_selector);
        }

        // Bug: missing `is_real` gate on selector-driven lookups.
    }

    Query(populate, self; eval, cols)
}
