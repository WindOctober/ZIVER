// Unrolled H01: two consecutive low/high-limb recompositions, plus a combined accumulator.

const u32 LIMB_BASE = 16777216;
const u32 HIGH_MAX = 127;

Struct LimbRecompositionH01Unrolled {
    output value0: u32,
    output low0: u32,
    output high0: u32,
    output low0_b0: u8,
    output low0_b1: u8,
    output low0_b2: u8,
    output is_max_high0: field,
    output value1: u32,
    output low1: u32,
    output high1: u32,
    output low1_b0: u8,
    output low1_b1: u8,
    output low1_b2: u8,
    output is_max_high1: field,
    output combined: u32,
}

Component LimbRecompositionH01Unrolled {
    Computation populate(self) {
        assert_range(self.low0, u24);
        assert_range(self.high0, u8);
        assert_eq(extract_bit_u32(self.high0, 7), 0);

        assert_range(self.low1, u24);
        assert_range(self.high1, u8);
        assert_eq(extract_bit_u32(self.high1, 7), 0);

        self.low0_b0 = to_bytes(self.low0)[0];
        self.low0_b1 = to_bytes(self.low0)[1];
        self.low0_b2 = to_bytes(self.low0)[2];
        self.is_max_high0 = 0;
        if (self.high0 == HIGH_MAX) {
            self.is_max_high0 = 1;
            assert_eq(self.low0, 0);
        }

        self.low1_b0 = to_bytes(self.low1)[0];
        self.low1_b1 = to_bytes(self.low1)[1];
        self.low1_b2 = to_bytes(self.low1)[2];
        self.is_max_high1 = 0;
        if (self.high1 == HIGH_MAX) {
            self.is_max_high1 = 1;
            assert_eq(self.low1, 0);
        }

        self.value0 = self.high0 * LIMB_BASE + self.low0;
        self.value1 = self.high1 * LIMB_BASE + self.low1;
        self.combined = self.value0 + self.value1;
    }

    Constraint eval(cols: LimbRecompositionH01Unrolled) {
        assert_range(cols.low0, u24);
        assert_range(cols.high0, u8);
        assert_eq(extract_bit_u32(cols.high0, 7), 0);
        assert_range(cols.low0_b0, u8);
        assert_range(cols.low0_b1, u8);
        assert_range(cols.low0_b2, u8);
        assert_bool(cols.is_max_high0);

        assert_range(cols.low1, u24);
        assert_range(cols.high1, u8);
        assert_eq(extract_bit_u32(cols.high1, 7), 0);
        assert_range(cols.low1_b0, u8);
        assert_range(cols.low1_b1, u8);
        assert_range(cols.low1_b2, u8);
        assert_bool(cols.is_max_high1);

        assert_eq(cols.low0_b0, to_bytes(cols.low0)[0]);
        assert_eq(cols.low0_b1, to_bytes(cols.low0)[1]);
        assert_eq(cols.low0_b2, to_bytes(cols.low0)[2]);
        assert_eq(cols.low1_b0, to_bytes(cols.low1)[0]);
        assert_eq(cols.low1_b1, to_bytes(cols.low1)[1]);
        assert_eq(cols.low1_b2, to_bytes(cols.low1)[2]);

        if (cols.high0 == HIGH_MAX) {
            assert_eq(cols.is_max_high0, 1);
            assert_eq(cols.low0, 0);
        } else {
            assert_eq(cols.is_max_high0, 0);
        }

        if (cols.high1 == HIGH_MAX) {
            assert_eq(cols.is_max_high1, 1);
            assert_eq(cols.low1, 0);
        } else {
            assert_eq(cols.is_max_high1, 0);
        }

        assert_eq(cols.combined, cols.value0 + cols.value1);

        // Bug: both limbs still omit `value = high * 2^24 + low`.
    }

    Query(populate, self; eval, cols)
}
