// Richer K2: include the routed multiplicity and the emitted lookup.

Struct RecursionIsRealBooleanK2Rich {
    input is_send: Selector,
    input clk: field,
    input addr: field,
    input value: field,
    output is_real: field,
    output routed_mult: field,
}

Component RecursionIsRealBooleanK2Rich {
    Computation populate(self) {
        assert_bool(self.is_send);
        assert_bool(self.is_real);

        self.routed_mult = self.is_real * self.is_send;

        if (self.routed_mult == 1) {
            lookup(Send, 0, self.clk, self.addr, self.value);
        }
    }

    Constraint eval(cols: RecursionIsRealBooleanK2Rich) {
        assert_bool(cols.is_send);
        assert_eq(cols.routed_mult, cols.is_real * cols.is_send);

        if (cols.routed_mult == 1) {
            lookup(Send, 0, cols.clk, cols.addr, cols.value);
        }

        // Bug: missing `assert_bool(is_real)`.
    }

    Query(populate, self; eval, cols)
}
