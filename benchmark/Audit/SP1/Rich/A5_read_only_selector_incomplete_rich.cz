// Richer A5: use a one-hot opcode class and expose both the read-only class and
// the write enable derived from it.

Struct ReadOnlySelectorA5Rich {
    input is_beq: Selector,
    input is_bne: Selector,
    input is_store: Selector,
    input is_syscall: Selector,
    input is_halt: Selector,
    input is_load: Selector,
    input prev_a: u32,
    input write_value: u32,
    output readonly_class: field,
    output will_write: field,
    output a_value: u32,
}

Component ReadOnlySelectorA5Rich {
    Computation populate(self) {
        field opcode_class =
            self.is_beq
            + self.is_bne
            + self.is_store
            + self.is_syscall
            + self.is_halt
            + self.is_load;

        assert_bool(self.is_beq);
        assert_bool(self.is_bne);
        assert_bool(self.is_store);
        assert_bool(self.is_syscall);
        assert_bool(self.is_halt);
        assert_bool(self.is_load);
        assert_bool(opcode_class);

        self.readonly_class =
            self.is_beq + self.is_bne + self.is_store + self.is_syscall + self.is_halt;
        assert_bool(self.readonly_class);
        self.will_write = self.is_load;
        self.a_value = self.readonly_class * self.prev_a + self.is_load * self.write_value;
    }

    Constraint eval(cols: ReadOnlySelectorA5Rich) {
        field opcode_class =
            cols.is_beq
            + cols.is_bne
            + cols.is_store
            + cols.is_syscall
            + cols.is_halt
            + cols.is_load;
        field readonly_buggy = cols.is_beq + cols.is_bne + cols.is_store;

        assert_bool(cols.is_beq);
        assert_bool(cols.is_bne);
        assert_bool(cols.is_store);
        assert_bool(cols.is_syscall);
        assert_bool(cols.is_halt);
        assert_bool(cols.is_load);
        assert_bool(opcode_class);
        assert_bool(readonly_buggy);

        assert_eq(cols.readonly_class, readonly_buggy);
        assert_eq(cols.will_write, cols.is_load);
        assert_eq(cols.a_value, readonly_buggy * cols.prev_a + cols.is_load * cols.write_value);

        // Bug: `is_syscall` and `is_halt` are read-only in the compute semantics,
        // but omitted from the read-only selector.
    }

    Query(populate, self; eval, cols)
}
