// Richer K4: keep the load opcode guard and the memory-read interaction.

Struct LoadValueBindingK4Rich {
    input is_real: Selector,
    input is_load: Selector,
    input clk: u32,
    input addr: u32,
    input memory_prev: field,
    input memory_cur: field,
    output mem_read_mult: field,
    output a_value: field,
}

Component LoadValueBindingK4Rich {
    Computation populate(self) {
        assert_bool(self.is_real);
        assert_bool(self.is_load);

        self.mem_read_mult = self.is_real * self.is_load;

        if (self.mem_read_mult == 1) {
            assert_eq(self.memory_prev, self.memory_cur);
            self.a_value = self.memory_cur;
            lookup(Send, 0, self.clk, self.addr, self.memory_cur);
        } else {
            self.a_value = 0;
        }
    }

    Constraint eval(cols: LoadValueBindingK4Rich) {
        assert_bool(cols.is_real);
        assert_bool(cols.is_load);
        assert_eq(cols.mem_read_mult, cols.is_real * cols.is_load);

        if (cols.mem_read_mult == 1) {
            assert_eq(cols.memory_prev, cols.memory_cur);
            lookup(Send, 0, cols.clk, cols.addr, cols.memory_cur);
        }

        // Bug: missing `a_value = memory_cur` on LOAD.
    }

    Query(populate, self; eval, cols)
}
