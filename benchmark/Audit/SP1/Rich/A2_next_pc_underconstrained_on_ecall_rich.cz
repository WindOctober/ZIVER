// Richer A2: keep more of the local ECALL chip state while preserving the same bug.

const u32 HALT_PC = 1;
const u32 ECALL_CLK_INC = 264;

Struct EcallNextPcA2Rich {
    input is_real: Selector,
    input is_halt: Selector,
    input op_a_0: Selector,
    input pc: u32,
    input clk: u32,
    input arg1: u32,
    output next_pc: u32,
    output next_clk: u32,
    output exit_code: u32,
}

Component EcallNextPcA2Rich {
    Computation populate(self) {
        assert_bool(self.is_real);
        assert_bool(self.is_halt);
        assert_bool(self.op_a_0);
        assert_zero(self.is_real * self.op_a_0);

        self.next_clk = self.is_real * (self.clk + ECALL_CLK_INC);
        self.next_pc =
            self.is_real * self.is_halt * HALT_PC
            + self.is_real * (1 - self.is_halt) * (self.pc + 4);
        self.exit_code = self.is_real * self.is_halt * self.arg1;
    }

    Constraint eval(cols: EcallNextPcA2Rich) {
        assert_bool(cols.is_real);
        assert_bool(cols.is_halt);
        assert_bool(cols.op_a_0);
        assert_zero(cols.is_real * cols.op_a_0);
        assert_eq(cols.next_clk, cols.is_real * (cols.clk + ECALL_CLK_INC));
        assert_zero(cols.is_real * cols.is_halt * (cols.next_pc - HALT_PC));
        assert_eq(cols.exit_code, cols.is_real * cols.is_halt * cols.arg1);

        // Bug: missing `next_pc = pc + 4` for real non-HALT ECALLs.
    }

    Query(populate, self; eval, cols)
}
