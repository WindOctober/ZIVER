// Richer A9: preserve the zero-row special case, but keep the surrounding
// receive behavior explicit.

Struct ProgramZeroReceiveA9Rich {
    input is_real: Selector,
    input pc: u32,
    input opcode: u32,
    input op_a_0: Selector,
    output is_zero_row: field,
    output receive_mult: field,
}

Component ProgramZeroReceiveA9Rich {
    Computation populate(self) {
        assert_bool(self.is_real);
        assert_bool(self.op_a_0);

        if (self.is_real == 0) {
            if (self.pc == 0) {
                if (self.opcode == 0) {
                    if (self.op_a_0 == 0) {
                        self.is_zero_row = 1;
                        self.receive_mult = 0;
                    } else {
                        self.is_zero_row = 0;
                        self.receive_mult = 1;
                    }
                } else {
                    self.is_zero_row = 0;
                    self.receive_mult = 1;
                }
            } else {
                self.is_zero_row = 0;
                self.receive_mult = 1;
            }
        } else {
            self.is_zero_row = 0;
            self.receive_mult = 1;
        }

        if (self.receive_mult == 1) {
            lookup(ReceiveInstruction, 0, self.pc, self.opcode, self.op_a_0);
        }
    }

    Constraint eval(cols: ProgramZeroReceiveA9Rich) {
        assert_bool(cols.is_real);
        assert_bool(cols.op_a_0);
        assert_bool(cols.is_zero_row);
        assert_bool(cols.receive_mult);

        if (cols.is_real == 1) {
            assert_eq(cols.is_zero_row, 0);
            assert_eq(cols.receive_mult, 1);
        } else {
            if (cols.pc == 0) {
                if (cols.opcode == 0) {
                    if (cols.op_a_0 == 1) {
                        assert_eq(cols.is_zero_row, 0);
                        assert_eq(cols.receive_mult, 1);
                    }
                } else {
                    assert_eq(cols.is_zero_row, 0);
                    assert_eq(cols.receive_mult, 1);
                }
            } else {
                assert_eq(cols.is_zero_row, 0);
                assert_eq(cols.receive_mult, 1);
            }
        }

        if (cols.receive_mult == 1) {
            lookup(ReceiveInstruction, 0, cols.pc, cols.opcode, cols.op_a_0);
        }

        // Bug: the all-zero padded row (`is_real = 0`, `pc = 0`, `opcode = 0`, `op_a_0 = 0`)
        // is still allowed to receive.
    }

    Query(populate, self; eval, cols)
}
