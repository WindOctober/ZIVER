// Richer K6: keep the opcode guard and the local next-pc increment.

const usize WORD_SIZE = 4;

Struct BneincUpperLimbsK6Rich {
    input is_bneinc: Selector,
    input prev_a: [u32; WORD_SIZE],
    input prev_pc: u32,
    output a: [u32; WORD_SIZE],
    output next_pc: u32,
}

Component BneincUpperLimbsK6Rich {
    Computation populate(self) {
        assert_bool(self.is_bneinc);

        for i in 0..WORD_SIZE {
            assert_range(self.prev_a[i], u8);
        }

        if (self.is_bneinc == 1) {
            self.a[0] = self.prev_a[0] + 1;
            self.a[1] = self.prev_a[1];
            self.a[2] = self.prev_a[2];
            self.a[3] = self.prev_a[3];
            self.next_pc = self.prev_pc + 1;
        } else {
            self.a[0] = self.prev_a[0];
            self.a[1] = self.prev_a[1];
            self.a[2] = self.prev_a[2];
            self.a[3] = self.prev_a[3];
            self.next_pc = self.prev_pc;
        }
    }

    Constraint eval(cols: BneincUpperLimbsK6Rich) {
        assert_bool(cols.is_bneinc);

        for i in 0..WORD_SIZE {
            assert_range(cols.prev_a[i], u8);
        }

        if (cols.is_bneinc == 1) {
            assert_eq(cols.a[0], cols.prev_a[0] + 1);
            assert_eq(cols.next_pc, cols.prev_pc + 1);
        } else {
            assert_eq(cols.next_pc, cols.prev_pc);
        }

        // Bug: missing `a[1..4] = prev_a[1..4]`.
    }

    Query(populate, self; eval, cols)
}
