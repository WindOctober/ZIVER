// crates\core\machine\src\operations\and.rs
// 编译和运行情况：由于按位与操作需要用lookup查表，这里还没实现，编译通不过

const usize WORD_SIZE = 4;

Struct AndOperation {
    output value: [field; WORD_SIZE],
}

Component AndOperation {

    Computation populate(self, record: Record, input x: [field; WORD_SIZE], input y: [field; WORD_SIZE]) -> [field; WORD_SIZE] {
        // 计算每个字节的 AND 结果
        for i in 0..WORD_SIZE {
            self.value[i] = op_and(x[i], y[i]);

            // 需要实现在lookup的send_byte
            ByteLookupEvent byte_event = ByteLookupEvent(ByteOpcode::AND, 0, 0, x[i], y[i]);  // 创建一个实例化事件
            record.add_byte_lookup_event(byte_event);  // 添加事件
        }

        return self.value;
    }

    Constraint eval(builder: AB, input a: [field; WORD_SIZE], input b: [field; WORD_SIZE], cols: AndOperation, is_real: Selector) {

        // 在约束中发送 lookup 事件到 builder
        for i in 0..WORD_SIZE {
            builder.send_byte(ByteOpcode::AND, cols.value[i], a[i], b[i], is_real);
        }
    }

    Query(populate, self, x, y; eval, cols, a, b)
}