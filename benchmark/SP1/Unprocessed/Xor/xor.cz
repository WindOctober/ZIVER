// crates/core/machine/src/operations/xor.rs
// 现状：1.缺少按位异或bit_xor(a,b) 2.缺少lookup的实现
const usize WORD_SIZE = 4;

Struct XorOperation {
    // 按字节保存 XOR 结果
    output value: [field; WORD_SIZE],
}

Component XorOperation {

    Computation populate(self, input a: [field; WORD_SIZE], input b: [field; WORD_SIZE]) -> [field; WORD_SIZE] {
        // sp1中的let expected = x ^ y;是先计算u32的整体异或值，这里是逐字节处理，就放到for循环里了
        // sp1中的x.to_le_bytes()和y.to_le_bytes() 是转化成4Byte数组，但cz中在input时就是字节数组，所以也不用实现
        
        // 问题1：把witness填入结果数组，需要补充bit_xor(a,b)
        for i in 0..WORD_SIZE {
            self.value[i] = bit_xor(a[i], b[i]); 
        }

        // 问题2：需要补充生成 byte lookup 查询记录,这里只是一个接口
        // add ByteLookupTable (
        //         opcode = 1,     // ByteOpcode::XOR(表示lookup支持的运算)
        //         out = self.value[i],
        //         a = a[i],
        //         b = b[i]
        // );

        return self.value;
    }

    Constraint eval(input a: [field; WORD_SIZE], input b: [field; WORD_SIZE], cols: XorOperation, is_real: field) {
        for i in 0..WORD_SIZE {
            // 检验是否是真实的数据
            assert(is_real); 
            // 这里是实现sp1中的send_byte，用等式约束先暂时实现
            assert_eq(cols.value[i], bit_xor(a[i], b[i])); 

            // 如果后面实现了lookup，就用下面的替换等式约束：
            // for i in 0..WORD_SIZE {
            //      lookup(ByteLookupTable)
            //           .columns(1, cols.value[i], a[i], b[i])
            //           .enable(is_real);
            // }
        }
    }
    
    Query(populate, a, b; eval, a, b) 
}