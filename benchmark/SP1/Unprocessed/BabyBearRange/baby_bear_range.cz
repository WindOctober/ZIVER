// crates/core/machine/src/operations/fixed_rotate_right.cz
// 运行情况：缺少把u32逐位展开

const usize WORD_SIZE = 4;

Struct BabyBearBitDecomposition {
    // 32 个比特的分解（低位到高位）
    output bits: [field; 32],

    // 用于对最高字节若干位的连乘（用于快速范围判定）
    output and_most_sig_byte_decomp_3_to_5: field,
    output and_most_sig_byte_decomp_3_to_6: field,
    output and_most_sig_byte_decomp_3_to_7: field,
}

Component BabyBearBitDecomposition {

    // 将 u32 value 展开到 bits[]，并计算连乘辅助列
    Computation populate(self, input value: u32) -> u32 {
        // 逐位展开：bits[i] = (value >> i) & 1，CertZero 目前不支持，需要实现 extract_bit_u32
        //     // fn extract_bit_u32(value: u32, index: usize) -> field
        for i in 0..32 {
            self.bits[i] = extract_bit_u32(value, i);
        }

        // most_sig_byte_decomp = bits[24..32]
        // 注意：在 DSL 中直接使用绝对索引以避免切片语义差异
        self.and_most_sig_byte_decomp_3_to_5 = self.bits[27] * self.bits[28];
        self.and_most_sig_byte_decomp_3_to_6 = self.and_most_sig_byte_decomp_3_to_5 * self.bits[29];
        self.and_most_sig_byte_decomp_3_to_7 = self.and_most_sig_byte_decomp_3_to_6 * self.bits[30];

        return 0;
    }


    Constraint eval(input value: field, cols: BabyBearBitDecomposition, is_real: field) {
        assert_bool(is_real);

        // 每个比特必须是布尔（0 或 1）
        for i in 0..32 {
            assert_bool(cols.bits[i]);
        }

        // 重构值：sum_{i=0..31} (2^i * bits[i])
        let mut reconstructed: field = 0;
        for i in 0..32 {
            // 需要实现位运算
            reconstructed = reconstructed + from_u32(1 << i) * cols.bits[i];
        }

        // 保证重构值等于输入 value
        assert_eq(is_real * (reconstructed - value), 0);

        // 最高字节第 7 位（最高位，overall bits[31]）必须为 0
        assert_eq(is_real * cols.bits[31], 0);

        // 验证连乘列的正确性（按索引来映射）
        // most_sig_byte_decomp[3] == bits[27]
        // most_sig_byte_decomp[4] == bits[28]
        // most_sig_byte_decomp[5] == bits[29]
        // most_sig_byte_decomp[6] == bits[30]
        assert_eq(is_real * (cols.and_most_sig_byte_decomp_3_to_5 - (cols.bits[27] * cols.bits[28])), 0);
        assert_eq(is_real * (cols.and_most_sig_byte_decomp_3_to_6 - (cols.and_most_sig_byte_decomp_3_to_5 * cols.bits[29])), 0);
        assert_eq(is_real * (cols.and_most_sig_byte_decomp_3_to_7 - (cols.and_most_sig_byte_decomp_3_to_6 * cols.bits[30])), 0);

        // 如果顶部连乘结果为 1，则低位（bits[0..26]）之和必须为 0
        // sp1中是对 cols.bits[0..27] 进行求和（切片到），这里对应索引 0..26
        let mut lower_bits_sum: field = 0;
        for i in 0..27 {
            lower_bits_sum = lower_bits_sum + cols.bits[i];
        }

        assert_eq(is_real * cols.and_most_sig_byte_decomp_3_to_7 * lower_bits_sum, 0);
    }

    // 关联 populate 与 eval
    Query(populate, self, value; eval, cols, value, is_real)
}