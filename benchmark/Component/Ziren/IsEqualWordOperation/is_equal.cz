// Ziren/crates/core/machine/src/operations/is_equal_word.rs

import is_zero_word;
const usize WORD_SIZE = 4;

Struct IsEqualWordOperation {
    output diff: [field; WORD_SIZE],
    output is_diff_zero: IsZeroWordOperation,
    output result: field,
}

Component IsEqualWordOperation {
    Computation populate(self, input a: [field; 4], input b: [field; 4], input is_real: field) -> field {
        self.diff[0] = a[0] - b[0];
        self.diff[1] = a[1] - b[1];
        self.diff[2] = a[2] - b[2];
        self.diff[3] = a[3] - b[3];

        field is_zero_u32 = self.is_diff_zero.populate(self.diff);
        field is_diff_zero = to_field(is_zero_u32);
        self.result = is_diff_zero;

        return self.result;
    }

    Constraint eval(input a: [field; 4], input b: [field; 4], cols: IsEqualWordOperation, input is_real: Selector) {
        assert_eq(cols.diff[0], a[0] - b[0]);
        assert_eq(cols.diff[1], a[1] - b[1]);
        assert_eq(cols.diff[2], a[2] - b[2]);
        assert_eq(cols.diff[3], a[3] - b[3]);

        IsZeroWordOperation::eval(cols.diff, cols.is_diff_zero, is_real);
        assert_eq(cols.result, cols.is_diff_zero.result);
    }

    Query(populate, self, a, b; eval, cols, a, b)
}
