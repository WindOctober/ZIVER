// Ziren/crates/core/machine/src/operations/is_zero_word.rs (local copy for imports)
import is_zero;

const usize WORD_SIZE = 4;

Struct IsZeroWordOperation {
    input is_zero_byte: [IsZeroOperation; WORD_SIZE],
    input is_lower_half_zero: F,
    input is_upper_half_zero: F,
    output result: F,
}

Component IsZeroWordOperation {
    Computation populate(self, a: [F; WORD_SIZE]) -> u32 {
        bool is_zero = true;
        for i in 0..WORD_SIZE {
            is_zero &= self.is_zero_byte[i].populate(a[i]) == 1;
        }
        self.is_lower_half_zero = self.is_zero_byte[0].result * self.is_zero_byte[1].result;
        self.is_upper_half_zero = self.is_zero_byte[2].result * self.is_zero_byte[3].result;
        self.result = to_field(is_zero);
        return to_u32(is_zero);
    }

    Constraint eval(a: [F; WORD_SIZE], cols: IsZeroWordOperation, is_real: Selector) {
        for i in 0..WORD_SIZE {
            IsZeroOperation::eval(a[i], cols.is_zero_byte[i], is_real);
        }

        assert_bool(cols.is_lower_half_zero);
        assert_bool(cols.is_upper_half_zero);
        assert_bool(cols.result);
        assert_eq(
            cols.is_lower_half_zero,
            cols.is_zero_byte[0].result * cols.is_zero_byte[1].result,
        );
        assert_eq(
            cols.is_upper_half_zero,
            cols.is_zero_byte[2].result * cols.is_zero_byte[3].result,
        );
        assert_eq(cols.result, cols.is_lower_half_zero * cols.is_upper_half_zero);
    }

    Query(populate, self, a; eval, cols, a)
}
