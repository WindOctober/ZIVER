// Ziren/crates/core/machine/src/operations/adddouble.rs

const usize WORD_SIZE = 4;
const field BASE = 256;

Enum ByteOpcode {
    ADD = 0;
    AND = 1;
    OR = 2;
    XOR = 3;
}

Struct AddDoubleOperation {
    // Low 32-bit sum bytes.
    output value: [field; WORD_SIZE],
    // High 32-bit sum bytes.
    output value_hi: [field; WORD_SIZE],
    // Carry bits across the 7 boundaries between the 8 bytes.
    output carry: [field; 7],
}

Component AddDoubleOperation {
    Computation populate(
        self,
        // Inputs as bytes, little endian.
        input a_lo: [field; WORD_SIZE],
        input a_hi: [field; WORD_SIZE],
        input b_lo: [field; WORD_SIZE],
        input b_hi: [field; WORD_SIZE]
    ) -> field {
        // Lower word addition (unrolled).
        field s0 = a_lo[0] + b_lo[0];
        if (s0 >= BASE) { self.carry[0] = 1; s0 = s0 - BASE; } else { self.carry[0] = 0; }
        self.value[0] = s0;

        field s1 = a_lo[1] + b_lo[1] + self.carry[0];
        if (s1 >= BASE) { self.carry[1] = 1; s1 = s1 - BASE; } else { self.carry[1] = 0; }
        self.value[1] = s1;

        field s2 = a_lo[2] + b_lo[2] + self.carry[1];
        if (s2 >= BASE) { self.carry[2] = 1; s2 = s2 - BASE; } else { self.carry[2] = 0; }
        self.value[2] = s2;

        field s3 = a_lo[3] + b_lo[3] + self.carry[2];
        if (s3 >= BASE) { self.carry[3] = 1; s3 = s3 - BASE; } else { self.carry[3] = 0; }
        self.value[3] = s3;

        // Upper word addition (carry in from lower word, unrolled).
        field s4 = a_hi[0] + b_hi[0] + self.carry[3];
        if (s4 >= BASE) { self.carry[4] = 1; s4 = s4 - BASE; } else { self.carry[4] = 0; }
        self.value_hi[0] = s4;

        field s5 = a_hi[1] + b_hi[1] + self.carry[4];
        if (s5 >= BASE) { self.carry[5] = 1; s5 = s5 - BASE; } else { self.carry[5] = 0; }
        self.value_hi[1] = s5;

        field s6 = a_hi[2] + b_hi[2] + self.carry[5];
        if (s6 >= BASE) { self.carry[6] = 1; s6 = s6 - BASE; } else { self.carry[6] = 0; }
        self.value_hi[2] = s6;

        field s7 = a_hi[3] + b_hi[3] + self.carry[6];
        if (s7 >= BASE) { s7 = s7 - BASE; } // overflow beyond 64 bits is dropped.
        self.value_hi[3] = s7;

        // Return low byte to keep populate deterministic.
        return self.value[0];
    }

    Constraint eval(
        input a_lo: [field; WORD_SIZE],
        input a_hi: [field; WORD_SIZE],
        input b_lo: [field; WORD_SIZE],
        input b_hi: [field; WORD_SIZE],
        cols: AddDoubleOperation,
        is_real: Selector
    ) {
        field one = 1;

        // Lower word overflow checks.
        field overflow_0 = a_lo[0] + b_lo[0] - cols.value[0];
        field overflow_1 = a_lo[1] + b_lo[1] - cols.value[1] + cols.carry[0];
        field overflow_2 = a_lo[2] + b_lo[2] - cols.value[2] + cols.carry[1];
        field overflow_3 = a_lo[3] + b_lo[3] - cols.value[3] + cols.carry[2];

        assert_zero(is_real * overflow_0 * (overflow_0 - BASE));
        assert_zero(is_real * overflow_1 * (overflow_1 - BASE));
        assert_zero(is_real * overflow_2 * (overflow_2 - BASE));
        assert_zero(is_real * overflow_3 * (overflow_3 - BASE));

        assert_zero(is_real * cols.carry[0] * (overflow_0 - BASE));
        assert_zero(is_real * cols.carry[1] * (overflow_1 - BASE));
        assert_zero(is_real * cols.carry[2] * (overflow_2 - BASE));
        assert_zero(is_real * cols.carry[3] * (overflow_3 - BASE));

        assert_zero(is_real * (cols.carry[0] - one) * overflow_0);
        assert_zero(is_real * (cols.carry[1] - one) * overflow_1);
        assert_zero(is_real * (cols.carry[2] - one) * overflow_2);
        assert_zero(is_real * (cols.carry[3] - one) * overflow_3);

        // Upper word overflow checks (carry in from lower word).
        field overflow_4 = a_hi[0] + b_hi[0] - cols.value_hi[0] + cols.carry[3];
        field overflow_5 = a_hi[1] + b_hi[1] - cols.value_hi[1] + cols.carry[4];
        field overflow_6 = a_hi[2] + b_hi[2] - cols.value_hi[2] + cols.carry[5];
        field overflow_7 = a_hi[3] + b_hi[3] - cols.value_hi[3] + cols.carry[6];

        assert_zero(is_real * overflow_4 * (overflow_4 - BASE));
        assert_zero(is_real * overflow_5 * (overflow_5 - BASE));
        assert_zero(is_real * overflow_6 * (overflow_6 - BASE));
        assert_zero(is_real * overflow_7 * (overflow_7 - BASE));

        assert_zero(is_real * cols.carry[4] * (overflow_4 - BASE));
        assert_zero(is_real * cols.carry[5] * (overflow_5 - BASE));
        assert_zero(is_real * cols.carry[6] * (overflow_6 - BASE));

        assert_zero(is_real * (cols.carry[4] - one) * overflow_4);
        assert_zero(is_real * (cols.carry[5] - one) * overflow_5);
        assert_zero(is_real * (cols.carry[6] - one) * overflow_6);

        // Carry bits boolean and row active.
        for i in 0..7 {
            assert_bool(cols.carry[i]);
        }
        assert_eq(is_real, one);

        // Range check each input/output byte via ByteChip lookups.
        for i in 0..WORD_SIZE {
            lookup(ByteChip, ByteOpcode::ADD, 0, a_lo[i], b_lo[i]);
            lookup(ByteChip, ByteOpcode::ADD, 0, a_hi[i], b_hi[i]);
            lookup(ByteChip, ByteOpcode::ADD, 0, cols.value[i], 0);
            lookup(ByteChip, ByteOpcode::ADD, 0, cols.value_hi[i], 0);
        }
    }

    Query(populate, self, a_lo, a_hi, b_lo, b_hi; eval, cols, a_lo, a_hi, b_lo, b_hi)
}
