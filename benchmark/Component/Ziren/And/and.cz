const usize WORD_SIZE = 4;

// Opcode selector for ByteChip lookups.
Enum ByteOpcode {
    ADD = 0;
    AND = 1;
    OR = 2;
    XOR = 3;
}

Struct AndOperation {
    output value: [field; WORD_SIZE],
}

Component AndOperation {
    Computation populate(self, x: u32, y: u32) {
        for i in 0..WORD_SIZE {
            self.value[i] = and(to_bytes(x)[i], to_bytes(y)[i]);
        }
    }

    Constraint eval(cols: AndOperation, a: u32, b: u32) {
        for i in 0..WORD_SIZE {
            lookup(ByteChip, ByteOpcode::AND, cols.value[i], to_bytes(a)[i], to_bytes(b)[i]);
        }
    }

    Query(populate, self, x, y; eval, cols, a, b)
}
