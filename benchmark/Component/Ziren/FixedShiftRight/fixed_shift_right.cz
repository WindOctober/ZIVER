// Ziren/crates/core/machine/src/operations/fixed_shift_right.rs

const usize WORD_SIZE = 4;

Struct FixedShiftRightOperation {
    // output value bytes
    output value_0: field, output value_1: field, output value_2: field, output value_3: field,

    // shrcarry outputs
    output shift_0: field, output shift_1: field, output shift_2: field, output shift_3: field,
    output carry_0: field, output carry_1: field, output carry_2: field, output carry_3: field,
}

Component FixedShiftRightOperation {
    // Prover-side population: prover fills witness columns (value, shift, carry)
    Computation populate(
        self,
        // input 32-bit little-endian bytes
        input a_0: field, input a_1: field, input a_2: field, input a_3: field,

        // rotation params (provided by caller)
        input nb_bytes_to_shift: u32, input nb_bits_to_shift: u32, input carry_multiplier: field,

        // witness values provided by prover
        input w_val_0: field, input w_val_1: field, input w_val_2: field, input w_val_3: field,
        input w_shift_0: field, input w_shift_1: field, input w_shift_2: field, input w_shift_3: field,
        input w_carry_0: field, input w_carry_1: field, input w_carry_2: field, input w_carry_3: field
    ) -> field {
        // base = 256 (byte radix)
        field base = 256;

        // write witnesses into columns
        self.value_0 = w_val_0; self.value_1 = w_val_1; self.value_2 = w_val_2; self.value_3 = w_val_3;
        self.shift_0 = w_shift_0; self.shift_1 = w_shift_1; self.shift_2 = w_shift_2; self.shift_3 = w_shift_3;
        self.carry_0 = w_carry_0; self.carry_1 = w_carry_1; self.carry_2 = w_carry_2; self.carry_3 = w_carry_3;

        // return reconstructed u32 (little-endian)
        return self.value_0 + self.value_1 * base + self.value_2 * base * base + self.value_3 * base * base * base;
    }

    // Verifier-side constraints
    Constraint eval(
        input a_0: field, input a_1: field, input a_2: field, input a_3: field,
        // rotation parameters supplied by caller (to avoid unsupported arithmetic in DSL)
        input nb_bytes_to_shift: u32, input nb_bits_to_shift: u32, input carry_multiplier: field,

        // witness values (must match populate)
        input w_val_0: field, input w_val_1: field, input w_val_2: field, input w_val_3: field,
        input w_shift_0: field, input w_shift_1: field, input w_shift_2: field, input w_shift_3: field,
        input w_carry_0: field, input w_carry_1: field, input w_carry_2: field, input w_carry_3: field,

        cols: FixedShiftRightOperation,
        is_real: field
    ) {
        // witness consistency
        assert_eq(cols.value_0, w_val_0); assert_eq(cols.value_1, w_val_1); assert_eq(cols.value_2, w_val_2); assert_eq(cols.value_3, w_val_3);
        assert_eq(cols.shift_0, w_shift_0); assert_eq(cols.shift_1, w_shift_1); assert_eq(cols.shift_2, w_shift_2); assert_eq(cols.shift_3, w_shift_3);
        assert_eq(cols.carry_0, w_carry_0); assert_eq(cols.carry_1, w_carry_1); assert_eq(cols.carry_2, w_carry_2); assert_eq(cols.carry_3, w_carry_3);

        // compute rotated input bytes B_i according to nb_bytes_to_shift (unrolled branches)
        field b_0 = 0; field b_1 = 0; field b_2 = 0; field b_3 = 0;
        if (nb_bytes_to_shift == 0) {
            b_0 = a_0; b_1 = a_1; b_2 = a_2; b_3 = a_3;
        } else {
            if (nb_bytes_to_shift == 1) {
                b_0 = a_1; b_1 = a_2; b_2 = a_3; b_3 = a_0;
            } else {
                if (nb_bytes_to_shift == 2) {
                    b_0 = a_2; b_1 = a_3; b_2 = a_0; b_3 = a_1;
                } else {
                    b_0 = a_3; b_1 = a_0; b_2 = a_1; b_3 = a_2;
                }
            }
        }

        // value combination constraints for fixed shift-right semantics:
        assert_eq(cols.value_2, cols.shift_2 + cols.carry_3 * carry_multiplier);
        assert_eq(cols.value_1, cols.shift_1 + cols.carry_2 * carry_multiplier);
        assert_eq(cols.value_0, cols.shift_0 + cols.carry_1 * carry_multiplier);
        assert_eq(cols.value_3, cols.shift_3);
    }

    // Query mapping: populate inputs -> eval inputs (witness pass-through)
    Query(
        populate, self,
        a_0, a_1, a_2, a_3,
        nb_bytes_to_shift, nb_bits_to_shift, carry_multiplier,
        w_val_0, w_val_1, w_val_2, w_val_3, w_shift_0, w_shift_1, w_shift_2, w_shift_3, w_carry_0, w_carry_1, w_carry_2, w_carry_3;

        eval, cols,
        a_0, a_1, a_2, a_3,
        nb_bytes_to_shift, nb_bits_to_shift, carry_multiplier,
        w_val_0, w_val_1, w_val_2, w_val_3, w_shift_0, w_shift_1, w_shift_2, w_shift_3, w_carry_0, w_carry_1, w_carry_2, w_carry_3
    )
}
