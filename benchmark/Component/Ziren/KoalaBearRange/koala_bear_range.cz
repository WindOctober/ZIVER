// Ziren/crates/core/machine/src/operations/koala_bear_range.rs

Struct KoalaBearBitDecomposition {
    // Bit decomposition of the value (least significant bit first).
    output bits: [field; 32],

    // Cumulative products over the most significant byte to check the KoalaBear modulus.
    output and_most_sig_byte_decomp_0_to_2: field,
    output and_most_sig_byte_decomp_0_to_3: field,
    output and_most_sig_byte_decomp_0_to_4: field,
    output and_most_sig_byte_decomp_0_to_5: field,
    output and_most_sig_byte_decomp_0_to_6: field,
    output and_most_sig_byte_decomp_0_to_7: field,
}

Component KoalaBearBitDecomposition {
    Computation populate(self, input value: u32) {
        for i in 0..32 {
            self.bits[i] = extract_bit_u32(value, i);
        }

        // Products of the top bits of the most-significant byte.
        self.and_most_sig_byte_decomp_0_to_2 = self.bits[24] * self.bits[25];
        self.and_most_sig_byte_decomp_0_to_3 = self.and_most_sig_byte_decomp_0_to_2 * self.bits[26];
        self.and_most_sig_byte_decomp_0_to_4 = self.and_most_sig_byte_decomp_0_to_3 * self.bits[27];
        self.and_most_sig_byte_decomp_0_to_5 = self.and_most_sig_byte_decomp_0_to_4 * self.bits[28];
        self.and_most_sig_byte_decomp_0_to_6 = self.and_most_sig_byte_decomp_0_to_5 * self.bits[29];
        self.and_most_sig_byte_decomp_0_to_7 = self.and_most_sig_byte_decomp_0_to_6 * self.bits[30];
    }

    Constraint eval(cols: KoalaBearBitDecomposition, input value: u32, is_real: Selector) {
        field reconstructed = 0;
        for i in 0..32 {
            assert_bool(cols.bits[i]);
        }

        reconstructed = reconstructed + from_u32(1) * cols.bits[0];
        reconstructed = reconstructed + from_u32(2) * cols.bits[1];
        reconstructed = reconstructed + from_u32(4) * cols.bits[2];
        reconstructed = reconstructed + from_u32(8) * cols.bits[3];
        reconstructed = reconstructed + from_u32(16) * cols.bits[4];
        reconstructed = reconstructed + from_u32(32) * cols.bits[5];
        reconstructed = reconstructed + from_u32(64) * cols.bits[6];
        reconstructed = reconstructed + from_u32(128) * cols.bits[7];
        reconstructed = reconstructed + from_u32(256) * cols.bits[8];
        reconstructed = reconstructed + from_u32(512) * cols.bits[9];
        reconstructed = reconstructed + from_u32(1024) * cols.bits[10];
        reconstructed = reconstructed + from_u32(2048) * cols.bits[11];
        reconstructed = reconstructed + from_u32(4096) * cols.bits[12];
        reconstructed = reconstructed + from_u32(8192) * cols.bits[13];
        reconstructed = reconstructed + from_u32(16384) * cols.bits[14];
        reconstructed = reconstructed + from_u32(32768) * cols.bits[15];
        reconstructed = reconstructed + from_u32(65536) * cols.bits[16];
        reconstructed = reconstructed + from_u32(131072) * cols.bits[17];
        reconstructed = reconstructed + from_u32(262144) * cols.bits[18];
        reconstructed = reconstructed + from_u32(524288) * cols.bits[19];
        reconstructed = reconstructed + from_u32(1048576) * cols.bits[20];
        reconstructed = reconstructed + from_u32(2097152) * cols.bits[21];
        reconstructed = reconstructed + from_u32(4194304) * cols.bits[22];
        reconstructed = reconstructed + from_u32(8388608) * cols.bits[23];
        reconstructed = reconstructed + from_u32(16777216) * cols.bits[24];
        reconstructed = reconstructed + from_u32(33554432) * cols.bits[25];
        reconstructed = reconstructed + from_u32(67108864) * cols.bits[26];
        reconstructed = reconstructed + from_u32(134217728) * cols.bits[27];
        reconstructed = reconstructed + from_u32(268435456) * cols.bits[28];
        reconstructed = reconstructed + from_u32(536870912) * cols.bits[29];
        reconstructed = reconstructed + from_u32(1073741824) * cols.bits[30];
        reconstructed = reconstructed + from_u32(2147483648) * cols.bits[31];
        assert_zero(is_real * (reconstructed - value));

        // The top bit of the most-significant byte must be zero (value < 0x8000_0000).
        assert_zero(is_real * cols.bits[31]);

        // Cumulative product checks for the most-significant byte.
        assert_zero(is_real * (cols.and_most_sig_byte_decomp_0_to_2 - cols.bits[24] * cols.bits[25]));
        assert_zero(
            is_real * (cols.and_most_sig_byte_decomp_0_to_3 - cols.and_most_sig_byte_decomp_0_to_2 * cols.bits[26]),
        );
        assert_zero(
            is_real * (cols.and_most_sig_byte_decomp_0_to_4 - cols.and_most_sig_byte_decomp_0_to_3 * cols.bits[27]),
        );
        assert_zero(
            is_real * (cols.and_most_sig_byte_decomp_0_to_5 - cols.and_most_sig_byte_decomp_0_to_4 * cols.bits[28]),
        );
        assert_zero(
            is_real * (cols.and_most_sig_byte_decomp_0_to_6 - cols.and_most_sig_byte_decomp_0_to_5 * cols.bits[29]),
        );
        assert_zero(
            is_real * (cols.and_most_sig_byte_decomp_0_to_7 - cols.and_most_sig_byte_decomp_0_to_6 * cols.bits[30]),
        );

        // If the most significant byte equals 0x7f (all of bits[24..30] are 1), then all lower
        // bytes must be zero to satisfy the KoalaBear modulus bound of 0x7f000001.
        field lower_bits_sum = 0;
        for i in 0..24 {
            lower_bits_sum = lower_bits_sum + cols.bits[i];
        }
        assert_zero(is_real * cols.and_most_sig_byte_decomp_0_to_7 * lower_bits_sum);
    }

    Query(populate, self, value; eval, cols, value)
}
