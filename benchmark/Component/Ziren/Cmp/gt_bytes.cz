// Ziren/crates/core/machine/src/operations/cmp.rs (GtColsBytes)

const usize WORD_SIZE = 4;

Enum ByteOpcode {
    ADD = 0;
    AND = 1;
    OR = 2;
    XOR = 3;
}

Struct GtBytesOperation {
    output byte_flags: [field; WORD_SIZE],
    output a_comparison_byte: field,
    output b_comparison_byte: field,
    output result: field,
}

Component GtBytesOperation {
    Computation populate(self, input a: u32, input b: u32) -> field {
        self.result = 0;
        self.a_comparison_byte = 0;
        self.b_comparison_byte = 0;
        self.byte_flags[0] = 0; self.byte_flags[1] = 0; self.byte_flags[2] = 0; self.byte_flags[3] = 0;

        field a0 = to_bytes(a)[0]; field a1 = to_bytes(a)[1]; field a2 = to_bytes(a)[2]; field a3 = to_bytes(a)[3];
        field b0 = to_bytes(b)[0]; field b1 = to_bytes(b)[1]; field b2 = to_bytes(b)[2]; field b3 = to_bytes(b)[3];

        field found = 0;
        if (found == 0) {
            if (a3 < b3) { self.byte_flags[3] = 1; self.a_comparison_byte = a3; self.b_comparison_byte = b3; self.result = 0; found = 1; }
            else { if (a3 > b3) { self.byte_flags[3] = 1; self.a_comparison_byte = a3; self.b_comparison_byte = b3; self.result = 1; found = 1; } }
        }
        if (found == 0) {
            if (a2 < b2) { self.byte_flags[2] = 1; self.a_comparison_byte = a2; self.b_comparison_byte = b2; self.result = 0; found = 1; }
            else { if (a2 > b2) { self.byte_flags[2] = 1; self.a_comparison_byte = a2; self.b_comparison_byte = b2; self.result = 1; found = 1; } }
        }
        if (found == 0) {
            if (a1 < b1) { self.byte_flags[1] = 1; self.a_comparison_byte = a1; self.b_comparison_byte = b1; self.result = 0; found = 1; }
            else { if (a1 > b1) { self.byte_flags[1] = 1; self.a_comparison_byte = a1; self.b_comparison_byte = b1; self.result = 1; found = 1; } }
        }
        if (found == 0) {
            if (a0 < b0) { self.byte_flags[0] = 1; self.a_comparison_byte = a0; self.b_comparison_byte = b0; self.result = 0; found = 1; }
            else { if (a0 > b0) { self.byte_flags[0] = 1; self.a_comparison_byte = a0; self.b_comparison_byte = b0; self.result = 1; found = 1; } }
        }

        return self.result;
    }

    Constraint eval(cols: GtBytesOperation, input a: u32, input b: u32, is_real: Selector) {
        assert_bool(is_real);
        assert_eq(is_real, 1);
        assert_bool(cols.result);

        // Recompute expected flags/result.
        field a0 = to_bytes(a)[0]; field a1 = to_bytes(a)[1]; field a2 = to_bytes(a)[2]; field a3 = to_bytes(a)[3];
        field b0 = to_bytes(b)[0]; field b1 = to_bytes(b)[1]; field b2 = to_bytes(b)[2]; field b3 = to_bytes(b)[3];

        field exp_result = 0;
        field exp_a_cmp = 0;
        field exp_b_cmp = 0;
        field exp_f0 = 0; field exp_f1 = 0; field exp_f2 = 0; field exp_f3 = 0;
        field found = 0;

        if (found == 0) {
            if (a3 < b3) { exp_f3 = 1; exp_a_cmp = a3; exp_b_cmp = b3; exp_result = 0; found = 1; }
            else { if (a3 > b3) { exp_f3 = 1; exp_a_cmp = a3; exp_b_cmp = b3; exp_result = 1; found = 1; } }
        }
        if (found == 0) {
            if (a2 < b2) { exp_f2 = 1; exp_a_cmp = a2; exp_b_cmp = b2; exp_result = 0; found = 1; }
            else { if (a2 > b2) { exp_f2 = 1; exp_a_cmp = a2; exp_b_cmp = b2; exp_result = 1; found = 1; } }
        }
        if (found == 0) {
            if (a1 < b1) { exp_f1 = 1; exp_a_cmp = a1; exp_b_cmp = b1; exp_result = 0; found = 1; }
            else { if (a1 > b1) { exp_f1 = 1; exp_a_cmp = a1; exp_b_cmp = b1; exp_result = 1; found = 1; } }
        }
        if (found == 0) {
            if (a0 < b0) { exp_f0 = 1; exp_a_cmp = a0; exp_b_cmp = b0; exp_result = 0; found = 1; }
            else { if (a0 > b0) { exp_f0 = 1; exp_a_cmp = a0; exp_b_cmp = b0; exp_result = 1; found = 1; } }
        }

        // Enforce equivalence with populated columns.
        assert_eq(cols.byte_flags[0], exp_f0); assert_bool(cols.byte_flags[0]);
        assert_eq(cols.byte_flags[1], exp_f1); assert_bool(cols.byte_flags[1]);
        assert_eq(cols.byte_flags[2], exp_f2); assert_bool(cols.byte_flags[2]);
        assert_eq(cols.byte_flags[3], exp_f3); assert_bool(cols.byte_flags[3]);

        assert_eq(cols.result, exp_result);
        assert_eq(cols.a_comparison_byte, exp_a_cmp);
        assert_eq(cols.b_comparison_byte, exp_b_cmp);

        // Equality before the first inequality.
        field eq_mask = 1;
        assert_eq(eq_mask * (a3 - b3), 0);
        eq_mask = eq_mask * (1 - cols.byte_flags[3]);
        assert_eq(eq_mask * (a2 - b2), 0);
        eq_mask = eq_mask * (1 - cols.byte_flags[2]);
        assert_eq(eq_mask * (a1 - b1), 0);
        eq_mask = eq_mask * (1 - cols.byte_flags[1]);
        assert_eq(eq_mask * (a0 - b0), 0);

        // Range check bytes.
        lookup(ByteChip, ByteOpcode::ADD, 0, a0, b0);
        lookup(ByteChip, ByteOpcode::ADD, 0, a1, b1);
        lookup(ByteChip, ByteOpcode::ADD, 0, a2, b2);
        lookup(ByteChip, ByteOpcode::ADD, 0, a3, b3);
    }

    Query(populate, self, a, b; eval, cols, a, b)
}
