// Ziren/crates/core/machine/src/operations/cmp.rs (AssertLtColsBytes)

const usize WORD_SIZE = 4;

Enum ByteOpcode {
    ADD = 0;
    AND = 1;
    OR = 2;
    XOR = 3;
}

Struct AssertLtBytesOperation {
    output byte_flags: [field; WORD_SIZE],
    output a_comparison_byte: field,
    output b_comparison_byte: field,
}

Component AssertLtBytesOperation {
    Computation populate(self, input a: u32, input b: u32) -> field {
        self.a_comparison_byte = 0;
        self.b_comparison_byte = 0;
        self.byte_flags[0] = 0; self.byte_flags[1] = 0; self.byte_flags[2] = 0; self.byte_flags[3] = 0;
        field found = 0;

        field a0 = to_bytes(a)[0]; field a1 = to_bytes(a)[1]; field a2 = to_bytes(a)[2]; field a3 = to_bytes(a)[3];
        field b0 = to_bytes(b)[0]; field b1 = to_bytes(b)[1]; field b2 = to_bytes(b)[2]; field b3 = to_bytes(b)[3];

        if (found == 0 && a3 < b3) { self.byte_flags[3] = 1; self.a_comparison_byte = a3; self.b_comparison_byte = b3; found = 1; }
        if (found == 0 && a2 < b2) { self.byte_flags[2] = 1; self.a_comparison_byte = a2; self.b_comparison_byte = b2; found = 1; }
        if (found == 0 && a1 < b1) { self.byte_flags[1] = 1; self.a_comparison_byte = a1; self.b_comparison_byte = b1; found = 1; }
        if (found == 0 && a0 < b0) { self.byte_flags[0] = 1; self.a_comparison_byte = a0; self.b_comparison_byte = b0; found = 1; }

        // Return comparison byte to make populate deterministic.
        return self.a_comparison_byte;
    }

    Constraint eval(cols: AssertLtBytesOperation, input a: u32, input b: u32, is_real: Selector) {
        assert_bool(is_real);
        assert_eq(is_real, 1);

        // Recompute expected flags; a must be strictly less than b.
        field a0 = to_bytes(a)[0]; field a1 = to_bytes(a)[1]; field a2 = to_bytes(a)[2]; field a3 = to_bytes(a)[3];
        field b0 = to_bytes(b)[0]; field b1 = to_bytes(b)[1]; field b2 = to_bytes(b)[2]; field b3 = to_bytes(b)[3];

        field exp_a_cmp = 0;
        field exp_b_cmp = 0;
        field exp_f0 = 0; field exp_f1 = 0; field exp_f2 = 0; field exp_f3 = 0;
        field found = 0;

        if (found == 0 && a3 < b3) { exp_f3 = 1; exp_a_cmp = a3; exp_b_cmp = b3; found = 1; }
        if (found == 0 && a2 < b2) { exp_f2 = 1; exp_a_cmp = a2; exp_b_cmp = b2; found = 1; }
        if (found == 0 && a1 < b1) { exp_f1 = 1; exp_a_cmp = a1; exp_b_cmp = b1; found = 1; }
        if (found == 0 && a0 < b0) { exp_f0 = 1; exp_a_cmp = a0; exp_b_cmp = b0; found = 1; }

        // Exactly one flag must be 1.
        field sum_flags = 0;
        assert_eq(cols.byte_flags[0], exp_f0); assert_bool(cols.byte_flags[0]); sum_flags = sum_flags + cols.byte_flags[0];
        assert_eq(cols.byte_flags[1], exp_f1); assert_bool(cols.byte_flags[1]); sum_flags = sum_flags + cols.byte_flags[1];
        assert_eq(cols.byte_flags[2], exp_f2); assert_bool(cols.byte_flags[2]); sum_flags = sum_flags + cols.byte_flags[2];
        assert_eq(cols.byte_flags[3], exp_f3); assert_bool(cols.byte_flags[3]); sum_flags = sum_flags + cols.byte_flags[3];
        assert_eq(sum_flags, 1);

        assert_eq(cols.a_comparison_byte, exp_a_cmp);
        assert_eq(cols.b_comparison_byte, exp_b_cmp);

        // Equality before the first inequality.
        field eq_mask = 1;
        assert_eq(eq_mask * (a3 - b3), 0);
        eq_mask = eq_mask * (1 - cols.byte_flags[3]);
        assert_eq(eq_mask * (a2 - b2), 0);
        eq_mask = eq_mask * (1 - cols.byte_flags[2]);
        assert_eq(eq_mask * (a1 - b1), 0);
        eq_mask = eq_mask * (1 - cols.byte_flags[1]);
        assert_eq(eq_mask * (a0 - b0), 0);

        // Range check bytes.
        lookup(ByteChip, ByteOpcode::ADD, 0, a0, b0);
        lookup(ByteChip, ByteOpcode::ADD, 0, a1, b1);
        lookup(ByteChip, ByteOpcode::ADD, 0, a2, b2);
        lookup(ByteChip, ByteOpcode::ADD, 0, a3, b3);
    }

    Query(populate, self, a, b; eval, cols, a, b)
}
