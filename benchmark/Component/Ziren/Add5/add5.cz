const usize WORD_SIZE = 4;
const field BASE = 256;

Enum ByteOpcode {
    ADD = 0;
    AND = 1;
    OR = 2;
    XOR = 3;
}

Struct Add5Operation {
    output value: [field; WORD_SIZE],
    // carry for each byte (0..4).
    output carry: [field; WORD_SIZE],
}

Component Add5Operation {
    Computation populate(self, a: u32, b: u32, c: u32, d: u32, e: u32) {
        field s0 =
            to_bytes(a)[0] + to_bytes(b)[0] + to_bytes(c)[0] + to_bytes(d)[0] + to_bytes(e)[0];
        if (s0 >= BASE * 4) {
            self.carry[0] = 4;
            s0 = s0 - BASE * 4;
        } else {
            if (s0 >= BASE * 3) {
                self.carry[0] = 3;
                s0 = s0 - BASE * 3;
            } else {
                if (s0 >= BASE * 2) {
                    self.carry[0] = 2;
                    s0 = s0 - BASE * 2;
                } else {
                    if (s0 >= BASE) {
                        self.carry[0] = 1;
                        s0 = s0 - BASE;
                    } else {
                        self.carry[0] = 0;
                    }
                }
            }
        }
        self.value[0] = s0;

        field s1 = to_bytes(a)[1]
            + to_bytes(b)[1]
            + to_bytes(c)[1]
            + to_bytes(d)[1]
            + to_bytes(e)[1]
            + self.carry[0];
        if (s1 >= BASE * 4) {
            self.carry[1] = 4;
            s1 = s1 - BASE * 4;
        } else {
            if (s1 >= BASE * 3) {
                self.carry[1] = 3;
                s1 = s1 - BASE * 3;
            } else {
                if (s1 >= BASE * 2) {
                    self.carry[1] = 2;
                    s1 = s1 - BASE * 2;
                } else {
                    if (s1 >= BASE) {
                        self.carry[1] = 1;
                        s1 = s1 - BASE;
                    } else {
                        self.carry[1] = 0;
                    }
                }
            }
        }
        self.value[1] = s1;

        field s2 = to_bytes(a)[2]
            + to_bytes(b)[2]
            + to_bytes(c)[2]
            + to_bytes(d)[2]
            + to_bytes(e)[2]
            + self.carry[1];
        if (s2 >= BASE * 4) {
            self.carry[2] = 4;
            s2 = s2 - BASE * 4;
        } else {
            if (s2 >= BASE * 3) {
                self.carry[2] = 3;
                s2 = s2 - BASE * 3;
            } else {
                if (s2 >= BASE * 2) {
                    self.carry[2] = 2;
                    s2 = s2 - BASE * 2;
                } else {
                    if (s2 >= BASE) {
                        self.carry[2] = 1;
                        s2 = s2 - BASE;
                    } else {
                        self.carry[2] = 0;
                    }
                }
            }
        }
        self.value[2] = s2;

        field s3 = to_bytes(a)[3]
            + to_bytes(b)[3]
            + to_bytes(c)[3]
            + to_bytes(d)[3]
            + to_bytes(e)[3]
            + self.carry[2];
        // carry[3] fits in 3 bits; final byte wraps but we do not expose carry beyond.
        if (s3 >= BASE * 4) {
            s3 = s3 - BASE * 4;
            self.carry[3] = 4;
        } else {
            if (s3 >= BASE * 3) {
                s3 = s3 - BASE * 3;
                self.carry[3] = 3;
            } else {
                if (s3 >= BASE * 2) {
                    s3 = s3 - BASE * 2;
                    self.carry[3] = 2;
                } else {
                    if (s3 >= BASE) {
                        s3 = s3 - BASE;
                        self.carry[3] = 1;
                    } else {
                        self.carry[3] = 0;
                    }
                }
            }
        }
        self.value[3] = s3;
    }

    Constraint eval(cols: Add5Operation, a: u32, b: u32, c: u32, d: u32, e: u32, is_real: Selector) {
        // Enforce carries are small bytes (combined with overflow equation, this pins them to 0..4).
        for i in 0..WORD_SIZE {
            assert_range(cols.carry[i], u8);
        }

        field overflow_0 =
            to_bytes(a)[0] + to_bytes(b)[0] + to_bytes(c)[0] + to_bytes(d)[0] + to_bytes(e)[0]
            - cols.value[0];
        field overflow_1 =
            to_bytes(a)[1] + to_bytes(b)[1] + to_bytes(c)[1] + to_bytes(d)[1] + to_bytes(e)[1]
            - cols.value[1] + cols.carry[0];
        field overflow_2 =
            to_bytes(a)[2] + to_bytes(b)[2] + to_bytes(c)[2] + to_bytes(d)[2] + to_bytes(e)[2]
            - cols.value[2] + cols.carry[1];
        field overflow_3 =
            to_bytes(a)[3] + to_bytes(b)[3] + to_bytes(c)[3] + to_bytes(d)[3] + to_bytes(e)[3]
            - cols.value[3] + cols.carry[2];

        // overflow_i must equal carry[i] * BASE.
        assert_zero(is_real * (overflow_0 - cols.carry[0] * BASE));
        assert_zero(is_real * (overflow_1 - cols.carry[1] * BASE));
        assert_zero(is_real * (overflow_2 - cols.carry[2] * BASE));
        assert_zero(is_real * (overflow_3 - cols.carry[3] * BASE));

        // Range check each byte of inputs and output.
        for i in 0..WORD_SIZE {
            lookup(ByteChip, ByteOpcode::ADD, 0, to_bytes(a)[i], to_bytes(b)[i]);
            lookup(ByteChip, ByteOpcode::ADD, 0, to_bytes(c)[i], to_bytes(d)[i]);
            lookup(ByteChip, ByteOpcode::ADD, 0, to_bytes(e)[i], 0);
            lookup(ByteChip, ByteOpcode::ADD, 0, cols.value[i], 0);
        }

        // Row is active.
        assert_eq(is_real, 1);
    }

    Query(populate, self, a, b, c, d, e; eval, cols, a, b, c, d, e)
}
