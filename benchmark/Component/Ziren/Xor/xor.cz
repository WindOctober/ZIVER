const usize WORD_SIZE = 4;

Enum ByteOpcode {
    ADD = 0;
    AND = 1;
    OR = 2;
    XOR = 3;
}

Struct XorOperation {
    output value: [field; WORD_SIZE],
}

Component XorOperation {
    Computation populate(self, a: u32, b: u32) {
        for i in 0..WORD_SIZE {
            self.value[i] = xor(to_bytes(a)[i], to_bytes(b)[i]);
        }
    }

    Constraint eval(cols: XorOperation, a: u32, b: u32) {
        for i in 0..WORD_SIZE {
            lookup(ByteChip, ByteOpcode::XOR, cols.value[i], to_bytes(a)[i], to_bytes(b)[i]);
        }
    }

    Query(populate, self, a, b; eval, cols, a, b)
}
