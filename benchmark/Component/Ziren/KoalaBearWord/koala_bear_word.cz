// Ziren/crates/core/machine/src/operations/koala_bear_word.rs

const usize WORD_SIZE = 4;

Struct KoalaBearWordRangeChecker {
    output most_sig_byte_decomp: [field; 8],

    output and_most_sig_byte_decomp_0_to_2: field,
    output and_most_sig_byte_decomp_0_to_3: field,
    output and_most_sig_byte_decomp_0_to_4: field,
    output and_most_sig_byte_decomp_0_to_5: field,
    output and_most_sig_byte_decomp_0_to_6: field,
    output and_most_sig_byte_decomp_0_to_7: field,
}

Component KoalaBearWordRangeChecker {
    // Populate with witness bits for the most significant byte.
    Computation populate(self, input value: [field; WORD_SIZE], input w_bits: [field; 8]) -> field {
        for i in 0..8 {
            self.most_sig_byte_decomp[i] = w_bits[i];
        }

        self.and_most_sig_byte_decomp_0_to_2 = self.most_sig_byte_decomp[0] * self.most_sig_byte_decomp[1];
        self.and_most_sig_byte_decomp_0_to_3 = self.and_most_sig_byte_decomp_0_to_2 * self.most_sig_byte_decomp[2];
        self.and_most_sig_byte_decomp_0_to_4 = self.and_most_sig_byte_decomp_0_to_3 * self.most_sig_byte_decomp[3];
        self.and_most_sig_byte_decomp_0_to_5 = self.and_most_sig_byte_decomp_0_to_4 * self.most_sig_byte_decomp[4];
        self.and_most_sig_byte_decomp_0_to_6 = self.and_most_sig_byte_decomp_0_to_5 * self.most_sig_byte_decomp[5];
        self.and_most_sig_byte_decomp_0_to_7 = self.and_most_sig_byte_decomp_0_to_6 * self.most_sig_byte_decomp[6];

        // Return the reconstructed most significant byte to keep populate deterministic.
        return self.most_sig_byte_decomp[0]
             + self.most_sig_byte_decomp[1] * from_u32(2)
             + self.most_sig_byte_decomp[2] * from_u32(4)
             + self.most_sig_byte_decomp[3] * from_u32(8)
             + self.most_sig_byte_decomp[4] * from_u32(16)
             + self.most_sig_byte_decomp[5] * from_u32(32)
             + self.most_sig_byte_decomp[6] * from_u32(64)
             + self.most_sig_byte_decomp[7] * from_u32(128);
    }

    Constraint eval(input value: [field; WORD_SIZE], input w_bits: [field; 8], cols: KoalaBearWordRangeChecker, is_real: Selector) {
        assert_bool(is_real);
        assert_eq(is_real, 1);
        for i in 0..8 {
            assert_eq(cols.most_sig_byte_decomp[i], w_bits[i]);
            assert_bool(cols.most_sig_byte_decomp[i]);
        }

        // Recompose the most significant byte.
        field recomposed = 0;
        recomposed = recomposed + from_u32(1) * cols.most_sig_byte_decomp[0];
        recomposed = recomposed + from_u32(2) * cols.most_sig_byte_decomp[1];
        recomposed = recomposed + from_u32(4) * cols.most_sig_byte_decomp[2];
        recomposed = recomposed + from_u32(8) * cols.most_sig_byte_decomp[3];
        recomposed = recomposed + from_u32(16) * cols.most_sig_byte_decomp[4];
        recomposed = recomposed + from_u32(32) * cols.most_sig_byte_decomp[5];
        recomposed = recomposed + from_u32(64) * cols.most_sig_byte_decomp[6];
        recomposed = recomposed + from_u32(128) * cols.most_sig_byte_decomp[7];
        assert_zero(is_real * (recomposed - value[3]));

        // Top bit must be zero for KoalaBear modulus bound.
        assert_zero(is_real * cols.most_sig_byte_decomp[7]);

        // Product checks for chained top bits.
        assert_zero(is_real * (cols.and_most_sig_byte_decomp_0_to_2 - cols.most_sig_byte_decomp[0] * cols.most_sig_byte_decomp[1]));
        assert_zero(is_real * (cols.and_most_sig_byte_decomp_0_to_3 - cols.and_most_sig_byte_decomp_0_to_2 * cols.most_sig_byte_decomp[2]));
        assert_zero(is_real * (cols.and_most_sig_byte_decomp_0_to_4 - cols.and_most_sig_byte_decomp_0_to_3 * cols.most_sig_byte_decomp[3]));
        assert_zero(is_real * (cols.and_most_sig_byte_decomp_0_to_5 - cols.and_most_sig_byte_decomp_0_to_4 * cols.most_sig_byte_decomp[4]));
        assert_zero(is_real * (cols.and_most_sig_byte_decomp_0_to_6 - cols.and_most_sig_byte_decomp_0_to_5 * cols.most_sig_byte_decomp[5]));
        assert_zero(is_real * (cols.and_most_sig_byte_decomp_0_to_7 - cols.and_most_sig_byte_decomp_0_to_6 * cols.most_sig_byte_decomp[6]));

        // If top bits are all 1 (i.e., == 0x7f), lower bytes must be zero.
        field lower_sum = value[0] + value[1] + value[2];
        assert_zero(is_real * cols.and_most_sig_byte_decomp_0_to_7 * lower_sum);
    }

    Query(populate, self, value, w_bits; eval, cols, value, w_bits)
}
