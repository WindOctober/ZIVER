const usize WORD_SIZE = 4;

Struct NotOperation {
    output value: [field; WORD_SIZE],
}

Component NotOperation {
    Computation populate(self, a: u32) {
        for i in 0..WORD_SIZE {
            // to_bytes(a)[i] is already a byte; 255 - byte implements bitwise NOT.
            self.value[i] = 255 - to_bytes(a)[i];
        }
    }

    Constraint eval(cols: NotOperation, a: u32) {
        for i in 0..WORD_SIZE {
            assert_eq(cols.value[i] + to_bytes(a)[i], 255);
        }
    }

    Query(populate, self, a; eval, cols, a)
}
