// crates/core/machine/src/operations/fixed_rotate_right.rs
// 编译和运行：因为这里没有lookup，所以这里现在的实现是依赖于手动输入的 witness。现在可以编译成功，也能够通过一致性检验

const usize WORD_SIZE = 4;

Struct FixedRotateRightOperation {
    
    // 旋转后的输出结果字节 (V_i)
    output value: [field; 4],

    // 右移操作的 Shift 输出字节 (S_i)
    output shift: [field; 4],

    // 右移操作的 Carry 输出字节 (C_i)
    output carry: [field; 4],
}

Component FixedRotateRightOperation {
    
    // ----------------------------------------------------
    // 1. Computation populate (Prover 端计算)
    // ----------------------------------------------------
    Computation populate(
        self,
        input a_0: field, input a_1: field, input a_2: field, input a_3: field,
        input nb_bytes_to_shift: u32, input nb_bits_to_shift: u32, input carry_multiplier: field,

        // 这里暂时没有用lookup，所以就直接由prover提供了
        // witness：由 Prover 提供的（value, shift, carry）
        input w_val_0: field, input w_val_1: field, input w_val_2: field, input w_val_3: field,
        input w_shift_0: field, input w_shift_1: field, input w_shift_2: field, input w_shift_3: field,
        input w_carry_0: field, input w_carry_1: field, input w_carry_2: field, input w_carry_3: field
    ) -> field {
        field base = 256;

        // 将 witness 写入列
        self.value[0] = w_val_0; self.value[1] = w_val_1; self.value[2] = w_val_2; self.value[3] = w_val_3;
        self.shift[0] = w_shift_0; self.shift[1] = w_shift_1; self.shift[2] = w_shift_2; self.shift[3] = w_shift_3;
        self.carry[0] = w_carry_0; self.carry[1] = w_carry_1; self.carry[2] = w_carry_2; self.carry[3] = w_carry_3;

        // 返回最终结果的 32 位整数值
        return self.value[0] + self.value[1] * base + self.value[2] * base * base + self.value[3] * base * base * base;
    }

    
    Constraint eval(
        input a_0: field, input a_1: field, input a_2: field, input a_3: field,
        input nb_bytes_to_shift: u32, input nb_bits_to_shift: u32, input carry_multiplier: field,

        // witness inputs: 与 populate 中一致，用于断言列一致性
        input w_val_0: field, input w_val_1: field, input w_val_2: field, input w_val_3: field,
        input w_shift_0: field, input w_shift_1: field, input w_shift_2: field, input w_shift_3: field,
        input w_carry_0: field, input w_carry_1: field, input w_carry_2: field, input w_carry_3: field,

        cols: FixedRotateRightOperation,
        is_real: field
    ) {
        // 0. Struct 字段与输入见证的一致性
        assert_eq(cols.value[0], w_val_0); assert_eq(cols.value[1], w_val_1); assert_eq(cols.value[2], w_val_2); assert_eq(cols.value[3], w_val_3);
        assert_eq(cols.shift[0], w_shift_0); assert_eq(cols.shift[1], w_shift_1); assert_eq(cols.shift[2], w_shift_2); assert_eq(cols.shift[3], w_shift_3);
        assert_eq(cols.carry[0], w_carry_0); assert_eq(cols.carry[1], w_carry_1); assert_eq(cols.carry[2], w_carry_2); assert_eq(cols.carry[3], w_carry_3);

        // --- 计算旋转后的输入字节 B_i ---
        // 根据 nb_bytes_to_shift 的取值 0..3 展开分支以避免不支持的模运算
        field b_0 = 0; field b_1 = 0; field b_2 = 0; field b_3 = 0;
        if (nb_bytes_to_shift == 0) {
            b_0 = a_0; b_1 = a_1; b_2 = a_2; b_3 = a_3;
        } else {
            if (nb_bytes_to_shift == 1) {
                b_0 = a_1; b_1 = a_2; b_2 = a_3; b_3 = a_0;
            } else {
                if (nb_bytes_to_shift == 2) {
                    b_0 = a_2; b_1 = a_3; b_2 = a_0; b_3 = a_1;
                } else {
                    b_0 = a_3; b_1 = a_0; b_2 = a_1; b_3 = a_2;
                }
            }
        }

        // --- ShrCarry 关系的约束（占位） ---
        // 原实现使用 Lookup (shr_carry)，这里我们保留占位函数签名以便后续实现：
        // // 占位签名（待实现）
        // // fn assert_shrcarry(b: field, nb_bits: usize, out_shift: field, out_carry: field, is_real: field)
        // 为当前语法，我们以简化的代数关系代替完整 lookup：
        // B_i == out_shift + out_carry * (1 << (8 - nb_bits)) （用于 value 组合处）

        // 旋转结果 Value 组合（显式展开）
        assert_eq(cols.value[2], cols.shift[2] + cols.carry[3] * carry_multiplier);
        assert_eq(cols.value[1], cols.shift[1] + cols.carry[2] * carry_multiplier);
        assert_eq(cols.value[0], cols.shift[0] + cols.carry[1] * carry_multiplier);
        assert_eq(cols.value[3], cols.shift[3] + cols.carry[0] * carry_multiplier);

        // 还需保证最高字节 shift/carry 与对应的 B_i 之间的一致性（简化约束）
        // 例如： B_0 = cols.shift_0 * 2^nb_bits_to_shift + cols.carry_0
        // 由于 CertZero 目前缺少 byte-level lookup/range_check 的通用实现，我们在此处保留注释并依赖上面的组合约束
    }

    // ----------------------------------------------------
    // 3. Query (关联)
    // ----------------------------------------------------
    Query(
        populate, self,
        a_0, a_1, a_2, a_3,
        nb_bytes_to_shift, nb_bits_to_shift, carry_multiplier,
        w_val_0, w_val_1, w_val_2, w_val_3, w_shift_0, w_shift_1, w_shift_2, w_shift_3, w_carry_0, w_carry_1, w_carry_2, w_carry_3;
        
        eval, cols,
        a_0, a_1, a_2, a_3,
        nb_bytes_to_shift, nb_bits_to_shift, carry_multiplier,
        w_val_0, w_val_1, w_val_2, w_val_3, w_shift_0, w_shift_1, w_shift_2, w_shift_3, w_carry_0, w_carry_1, w_carry_2, w_carry_3
    )
}