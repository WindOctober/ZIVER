// crates/core/machine/src/operations/xor.rs 对应的 cz 约束
const usize WORD_SIZE = 4;

Struct XorOperation {
    output value: [field; WORD_SIZE],
}

Component XorOperation {

    Computation populate(self, input a: [field; WORD_SIZE], input b: [field; WORD_SIZE]) {
        for i in 0..WORD_SIZE {
            assert_range(a[i], u8);
            assert_range(b[i], u8);
            self.value[i] = xor(a[i], b[i]);
        }
    }

    Constraint eval(cols: XorOperation, input a: [field; WORD_SIZE], input b: [field; WORD_SIZE]) {
        for i in 0..WORD_SIZE {
            lookup(ByteChip, 3, cols.value[i], a[i], b[i]);
        }
    }
    
    Query(populate, self, a, b; eval, cols, a, b) 
}
