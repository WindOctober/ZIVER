const usize WORD_SIZE = 4;

Struct AndOperation {
    output value: [field; WORD_SIZE],
}

Component AndOperation {
    Computation populate(self, x: [field; WORD_SIZE], y: [field; WORD_SIZE]) {
        for i in 0..WORD_SIZE {
            assert_range(x[i], u8);
            assert_range(y[i], u8);
            self.value[i] = and(x[i], y[i]);
        }
    }

    Constraint eval(cols: AndOperation, a: [field; WORD_SIZE], b: [field; WORD_SIZE]) {
        for i in 0..WORD_SIZE {
            lookup(ByteChip, 1, cols.value[i], a[i], b[i]);
        }
    }

    Query(populate, self, x, y; eval, cols, a, b)
}
