// crates\core\machine\src\operations\not.rs
// 现状：现在的这个实现版本能跑通，但是缺功能(1.处理field类型元素的for 2.record范围检查)
const usize WORD_SIZE = 4;

Struct NotOperation {
    output value: [field; WORD_SIZE], 
}

Component NotOperation {
    Computation populate(self, a: [field; WORD_SIZE]) -> u32 { 
        
        // 本来是要写成for循环的，但写成for循环编译过不了
        // 原因：这里是需要循环处理field元素类型，执行器无法处理这种类型的循环索引
        // is_zero_word.cz中能使用for的原因：它处理的是IsZeroOperation(Struct类型)
        // 所以这里我就先手动展开四个字节这样来表达了
        // 如果能支持for的话，应该是这样：
        // for i in 0..WORD_SIZE {
        //     self.value[i] = 255 - a[i];
        // }
        self.value[0] = 255 - a[0];
        self.value[1] = 255 - a[1];
        self.value[2] = 255 - a[2];
        self.value[3] = 255 - a[3];

        // 还有一个record需要实现，是一个范围检查 assert_is_byte(a[i])
        // for i in 0..WORD_SIZE {
        //     assert_is_byte(a[i]);
        // }

        return 0;
    }

    Constraint eval(cols: NotOperation, a: [field; WORD_SIZE]) { 
        // 检查1：按位非的结果是否正确(这里也是先全部展开写的，后面也可以改成for循环)
        // for i in 0..WORD_SIZE {
        //     assert_eq(cols.value[i], 255 - a[i]);
        // }
        assert_eq(cols.value[0], 255 - a[0]);
        assert_eq(cols.value[1], 255 - a[1]);
        assert_eq(cols.value[2], 255 - a[2]);
        assert_eq(cols.value[3], 255 - a[3]);

        // 检查2：范围检查(输入的每个字节都在0-255范围内)
        // for i in 0..WORD_SIZE {
        //     RangeCheck256::eval(a[i], is_real);
        // }
    }

    // record还没实现，所以这里先暂时没有把record写进来比较
    // 如果实现以后是这样的：Query(populate, self, a, record; eval, cols, a, record)
    Query(populate, self, a; eval, cols, a) 
}