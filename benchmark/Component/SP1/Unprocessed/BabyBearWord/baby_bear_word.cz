// crates/core/machine/src/operations/baby_bear_word.rs
// 编译/运行情况：能正常编译，运行，一致性检查能通过
// 需要实现lookup的

const usize WORD_SIZE = 4;

Struct BabyBearWordRangeChecker {
    output most_sig_byte_lt_120: field,
}

Component BabyBearWordRangeChecker {

    Computation populate(self, input value: [field; WORD_SIZE]) -> u32 {
        // 当最高字节 < 120 时设置为 1，否则为 0。
        field ms = value[3];  // 最高字节。
        if (ms < 120) {
            self.most_sig_byte_lt_120 = 1;
        } else {
            self.most_sig_byte_lt_120 = 0;
        }

        // 需要实现 ByteLookupEvent 添加到 Record 后续 lookup
        // record.add_byte_lookup_event(ByteLookupEvent(...)).

        if (self.most_sig_byte_lt_120 == 1) { return 1; } else { return 0; }
    }

    
    Constraint eval(input value: [field; WORD_SIZE], cols: BabyBearWordRangeChecker, is_real: field) {

        // Populated value: cols.most_sig_byte_lt_120 == 1 iff value[3] < 120.
        // Enforce equivalence directly (no external primitive call) so the symbolic checker can verify.
        if (value[3] < 120) {
            assert_eq(cols.most_sig_byte_lt_120, 1);
        } else {
            assert_eq(cols.most_sig_byte_lt_120, 0);

            // if not lt (i.e., ms >= 120), the allowed value for a valid BabyBear word is ms == 120
            assert_eq(value[3], 120);

            // and lower three bytes must be zero
            assert_eq(value[0], 0);
            assert_eq(value[1], 0);
            assert_eq(value[2], 0);
        }

        // Ensure flag is boolean
        assert_bool(cols.most_sig_byte_lt_120);
    }
 
    Query(populate, self, value; eval, cols, value)
}
