const usize NUM_BITS = 32;
const usize TOP_BITS_START = 27;

Struct BabyBearBitDecomposition {
    output bits: [field; NUM_BITS],
    output and_most_sig_byte_decomp_3_to_5: field,
    output and_most_sig_byte_decomp_3_to_6: field,
    output and_most_sig_byte_decomp_3_to_7: field,
}

Component BabyBearBitDecomposition {
    Computation populate(self, value: field) -> field {
        for i in 0..NUM_BITS {
            self.bits[i] = extract_bit_u32(value, i);
        }

        self.and_most_sig_byte_decomp_3_to_5 = self.bits[27] * self.bits[28];
        self.and_most_sig_byte_decomp_3_to_6 = self.and_most_sig_byte_decomp_3_to_5 * self.bits[29];
        self.and_most_sig_byte_decomp_3_to_7 = self.and_most_sig_byte_decomp_3_to_6 * self.bits[30];

        return value;
    }

    Constraint eval(value: field, cols: BabyBearBitDecomposition) {
        // Bits must be boolean.
        for i in 0..NUM_BITS {
            assert_bool(cols.bits[i]);
        }

        // Reconstruct value from bits using powers of two.
        field reconstructed = 0;
        field weight = 1;
        for i in 0..NUM_BITS {
            if (i > 0) {
                weight = weight * 2;
            }
            reconstructed = reconstructed + weight * cols.bits[i];
        }
        assert_eq(reconstructed, value);

        // Most significant bit must be zero for the BabyBear modulus check.
        assert_eq(cols.bits[31], 0);

        // Verify the chained products for top bits of the most significant byte.
        field and_3_to_5 = cols.bits[27] * cols.bits[28];
        field and_3_to_6 = and_3_to_5 * cols.bits[29];
        field and_3_to_7 = and_3_to_6 * cols.bits[30];
        assert_eq(cols.and_most_sig_byte_decomp_3_to_5, and_3_to_5);
        assert_eq(cols.and_most_sig_byte_decomp_3_to_6, and_3_to_6);
        assert_eq(cols.and_most_sig_byte_decomp_3_to_7, and_3_to_7);

        // If the top bits are all 1, the lower bits must sum to 0.
        field lower_bits_sum = 0;
        for i in 0..TOP_BITS_START {
            lower_bits_sum = lower_bits_sum + cols.bits[i];
        }
        assert_eq(and_3_to_7 * lower_bits_sum, 0);
    }

    Query(populate, self, value; eval, cols, value)
}
